# Client environment (Vite)
# Copy to .env / .env.local / .env.production as needed.
# Only variables prefixed with VITE_ are exposed to the browser.

# Backend API origin (no trailing slash).
# Leave empty for local development (uses Vite proxy → http://localhost:5001).
# Production example:
# VITE_API_URL=https://ecolelaracine.online
VITE_API_URL=

# Optional Socket.IO origin. Defaults to VITE_API_URL when set.
# VITE_SOCKET_URL=https://ecolelaracine.online
VITE_SOCKET_URL=

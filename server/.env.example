DATABASE_URL="postgresql://postgres:password@localhost:5432/laracine_school?schema=public"
PORT=5001

# Gmail SMTP — parent announcement & message emails
# Use a Google App Password (not your normal Gmail password)
SMTP_USER=
SMTP_PASS=
CLIENT_URL=http://localhost:3000

# BulkSMS (https://www.bulksms.com) — parent broadcast SMS
# Create a token under Settings → Developer Settings → API Tokens
SMS_ENABLED=false
BULKSMS_TOKEN_ID=
BULKSMS_TOKEN_SECRET=
# Optional alphanumeric sender ID (must be approved on your BulkSMS account)
BULKSMS_SENDER_ID=LaRACINE

# Student AI tutor (Ask Racine AI)
# Prefer FREE providers (checked in this order):
# 1) Groq  — free key: https://console.groq.com/keys
GROQ_API_KEY=
# 2) Google Gemini — free key: https://aistudio.google.com/apikey
# GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_API_KEY=
# Optional: force provider = groq | gemini | openai | gateway
AI_PROVIDER=groq
# Optional model override
# Groq default: llama-3.1-8b-instant
# Gemini default: gemini-2.0-flash
# AI_MODEL=llama-3.1-8b-instant

# Paid options (only if you have credits)
# OPENAI_API_KEY=
# AI_GATEWAY_API_KEY=

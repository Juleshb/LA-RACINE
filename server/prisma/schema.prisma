/// Public marketing website CMS — one JSON document per page + locale
model WebsiteContent {
  id        String   @id @default(uuid())
  slug      String
  locale    String
  label     String
  data      Json
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slug, locale])
  @@index([locale])
}

model ContactInquiry {
  id        String               @id @default(uuid())
  name      String
  email     String
  subject   String?
  message   String
  campusId  String?
  campus    Campus?              @relation(fields: [campusId], references: [id], onDelete: SetNull)
  status    ContactInquiryStatus @default(OPEN)
  replies   ContactInquiryReply[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([email])
  @@index([status])
  @@index([campusId])
}

model ContactInquiryReply {
  id          String         @id @default(uuid())
  inquiryId   String
  inquiry     ContactInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  body        String
  isVisitor   Boolean        @default(false)
  repliedById String?
  repliedBy   User?          @relation(fields: [repliedById], references: [id], onDelete: Restrict)
  createdAt   DateTime       @default(now())
}

model ContactOtpCode {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

model ContactChatSession {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

enum ContactInquiryStatus {
  OPEN
  REPLIED
  CLOSED
}
